{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/send-email?action=daily-matrix&respectSchedule=true",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/send-email?action=daily-followup&respectSchedule=true&syncReplies=1",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    { "source": "/docs", "destination": "/api/docs" },
    { "source": "/api/openapi.json", "destination": "/api/docs?format=json" },
    { "source": "/api/context", "destination": "/api/docs?format=context" },
    { "source": "/api/project-context", "destination": "/api/docs?format=context" },
    { "source": "/api/v1/ai/inspect-paperwork", "destination": "/api/upload-photo?action=inspect-paperwork" },
    { "source": "/api/v1/auth/verify-pin", "destination": "/api/v1/api-keys?action=verify-pin" },
    { "source": "/api/v1/auth/clear-cooldown", "destination": "/api/v1/api-keys?action=clear-cooldown" },
    { "source": "/api/v1/rma-email-edit", "destination": "/api/v1/rma?action=email-edit" },
    { "source": "/api/v1/api-keys/:id", "destination": "/api/v1/api-keys/[id]?id=:id" },
    { "source": "/api/v1/rma/:id", "destination": "/api/v1/rma/[id]?id=:id" },
    { "source": "/api/v1/products/:id", "destination": "/api/v1/products/[id]?id=:id" },
    { "source": "/api/v1/credit-memos/:id", "destination": "/api/v1/credit-memos/[id]?id=:id" },
    { "source": "/((?!api/|PROJECT_CONTEXT\\.txt).*)", "destination": "/index.html" }
  ]
}
