{
  "rewrites": [
    { "source": "/docs", "destination": "/api/docs" },
    { "source": "/api/openapi.json", "destination": "/api/docs?format=json" },
    { "source": "/api/v1/auth/verify-pin", "destination": "/api/v1/api-keys?action=verify-pin" },
    { "source": "/api/v1/auth/clear-cooldown", "destination": "/api/v1/api-keys?action=clear-cooldown" },
    { "source": "/api/v1/api-keys/:id", "destination": "/api/v1/api-keys/[id]?id=:id" },
    { "source": "/api/v1/rma/:id", "destination": "/api/v1/rma/[id]?id=:id" },
    { "source": "/api/v1/products/:id", "destination": "/api/v1/products/[id]?id=:id" },
    { "source": "/api/v1/credit-memos/:id", "destination": "/api/v1/credit-memos/[id]?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
